# Logs
logs
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
lerna-debug.log*

node_modules
dist
dist-ssr
*.local

# Editor directories and files
.vscode/
.idea
.DS_Store
*.suo
*.ntvs*
*.njsproj
*.sln
*.sw?

# Local env overrides - .env.example itself IS committed (it's the template)
.env
.env.local

HYDRA-UMC-STUDIO.zip
# HYDRA-UMC shared secret protection
!.env.example

# Python bytecode (generated locally; never source)
__pycache__/
*.py[cod]

# Local trash folder the model editors create inside public/models, and their temporary backups
.trash/
public/models/**/*.bak

# npm is the package manager of this project (package-lock.json); another manager's lockfile would drift from it
bun.lock
bun.lockb

# The 3D model files shared with HYDRA-UMC-SUITE come from the verified mesh package (docs/MESH_PACKAGE.md); a download
# must never be committed. A new model is added on purpose with git add -f and goes into a new revision of the package.
public/models/**/*.stl
public/models/**/*.STL
public/models/**/*.amf
public/models/**/*.3mf
